# =============================================================================
# ResearchForge — free/low-cost cloud deployment env template
#
# Every variable across all providers, grouped by WHERE it gets set.
# Nothing here is read from a file in production: copy each block into the
# provider's own secret store (`fly secrets set`, Vercel env vars).
#
# Variable names below are verified against apps/api/app/core/config.py.
# Full walkthrough: infra/deploy/DEPLOYMENT.md
# =============================================================================


# =============================================================================
# 1. FLY.IO — API app (researchforge-api)  +  worker app (researchforge-worker)
#    Both apps need the SAME values for everything in this section.
#    Set with:  fly secrets set --app researchforge-api KEY=value ...
#
#    APP_ENV / LOG_LEVEL / COOKIE_* / S3_USE_SSL / S3_REGION are already in
#    [env] in the fly.*.toml files — do not duplicate them as secrets.
# =============================================================================

# --- Signing secrets. Generate with: npm run secrets ---------------------------
SECRET_KEY=
CSRF_SECRET=

# --- Public URLs (the Vercel domain — NOT the Fly domain) ----------------------
# Browsers only ever talk to Vercel; Next.js rewrites /api/* to Fly server-side.
PUBLIC_APP_URL=https://researchforge.vercel.app
CORS_ORIGINS=https://researchforge.vercel.app

# --- Database: Supabase ---------------------------------------------------------
# Use the SESSION POOLER string (port 5432 on *.pooler.supabase.com).
#
# Why not the transaction pooler (6543): the app AND Alembic both connect with
# asyncpg, which uses prepared statements. Transaction-mode pooling breaks those
# unless the engine is built with statement caching disabled, and
# apps/api/app/db/session.py builds the engine with no connect_args. Session mode
# needs no code change.
#
# Why not the direct db.<ref>.supabase.co host: it is IPv6-only on new projects.
#
# Driver prefix must stay postgresql+asyncpg — Supabase gives you a bare
# postgresql:// string, so rewrite the scheme.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Declared in config.py but not read by any module or by Alembic (env.py uses
# DATABASE_URL). Kept in sync so nothing surprises you later.
DATABASE_URL_SYNC=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- Redis: self-hosted on Fly (infra/deploy/fly/fly.redis.toml) --------------------
# Private 6PN hostname — no public IP, no TLS needed (the 6PN network is
# encrypted between machines). Keep the /0 /1 /2 database split; a real Redis
# supports it, so app cache, Celery broker and Celery results stay separated.
#
# <redis-password> is the REDIS_PASSWORD secret you set on researchforge-redis.
#
# Not Upstash: a Celery worker's idle BRPOP loop alone would exhaust the free
# command allowance. Upstash is fine for REDIS_URL on its own (rate limiting is
# low-volume) but then you are running two Redis providers for no benefit.
REDIS_URL=redis://default:<redis-password>@researchforge-redis.internal:6379/0
CELERY_BROKER_URL=redis://default:<redis-password>@researchforge-redis.internal:6379/1
CELERY_RESULT_BACKEND=redis://default:<redis-password>@researchforge-redis.internal:6379/2

# --- Object storage: Cloudflare R2 (S3-compatible) --------------------------------
# R2 has no regions; S3_REGION must literally be "auto" (already set in fly toml).
#
# NOTE the ".eu." segment: buckets created with the European Union jurisdiction
# are only reachable on the jurisdiction-specific endpoint. Using the plain
# https://<account-id>.r2.cloudflarestorage.com form against an EU bucket fails
# with a misleading "bucket does not exist". Copy whatever the R2 API token
# result screen shows rather than typing it.
S3_ENDPOINT_URL=https://<cloudflare-account-id>.eu.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_BUCKET=researchforge

# --- LLM: Groq (OpenAI-compatible) -------------------------------------------------
# AI_PROVIDER stays openai_compatible — no code change, config.py already aliases
# AI_BASE_URL -> llm_base_url, AI_API_KEY -> llm_api_key, AI_MODEL_NAME -> llm_model.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=<groq-api-key>
AI_MODEL_NAME=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=2048

# EMBEDDING_BASE_URL: leave UNSET. Groq serves no /embeddings endpoint, and
# apps/api/app/services/files/embeddings.py falls back to the deterministic
# 64-dim hash embedder whenever this is empty. Retrieval still works, but
# semantic ranking is weak — see DEPLOYMENT.md "Known limitations".
# EMBEDDING_BASE_URL=

# --- Email ---------------------------------------------------------------------------
# config.py only accepts "console" or "fake". console logs the message instead of
# sending it, so verification/reset links must be read out of `fly logs`.
EMAIL_PROVIDER=console

# --- Google OAuth (optional; off by default) ------------------------------------------
# The callback must be the VERCEL origin — Next.js proxies it through to Fly.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://researchforge.vercel.app/api/v1/auth/oauth/google/callback

# --- Optional tuning (all have working defaults in config.py) ---------------------------
# MAX_UPLOAD_BYTES=26214400
# EXPORT_DOWNLOAD_EXPIRE_SECONDS=900
# EXPORT_MAX_JOBS_PER_DAY=50
# RATE_LIMIT_DEFAULT=100/minute
# GUEST_OUTLINE_MAX_SECTIONS=6
# TRASH_RETENTION_DAYS=30


# =============================================================================
# 2. VERCEL — Next.js project (Root Directory = apps/web)
#    Set these in Project Settings -> Environment Variables (Production).
# =============================================================================

# Server-side only: where Next.js rewrites forward /api/* and /health/*.
# This is the one place the Fly hostname appears. No trailing slash.
API_PROXY_TARGET=https://researchforge-api.fly.dev

# Browser-visible. NEXT_PUBLIC_API_URL is the Vercel origin, not Fly — requests
# go same-origin so auth cookies are first-party. This is what the
# API_PROXY_TARGET indirection exists for.
NEXT_PUBLIC_APP_URL=https://researchforge.vercel.app
NEXT_PUBLIC_API_URL=https://researchforge.vercel.app
NEXT_PUBLIC_API_PREFIX=/api/v1


# =============================================================================
# 3. NOT USED IN THIS DEPLOYMENT
#    Present in the root .env.example for local Docker Compose only:
#      POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_HOST /
#      POSTGRES_PORT   -> replaced by the Supabase DATABASE_URL
#      API_HOST / API_PORT -> set in fly.api.toml [env]
#      COOKIE_DOMAIN   -> must stay EMPTY; the proxy keeps cookies first-party
#      AI_PROVIDER_FOR_TESTS -> test-only
# =============================================================================
