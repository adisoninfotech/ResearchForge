# =============================================================================
# ResearchForge — root environment template
# Copy to .env and fill values. Never commit real secrets.
# Generate local secrets: npm run secrets
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=ResearchForge
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser calls the Next.js origin; API is proxied via API_PROXY_TARGET (cookie-friendly).
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_PREFIX=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000

# --- Backend (apps/api) ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-use-npm-run-secrets
CSRF_SECRET=change-me-use-npm-run-secrets
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_LAST_SEEN_MIN_INTERVAL_SECONDS=300
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_HOURS=1
PUBLIC_APP_URL=http://localhost:3000
EMAIL_PROVIDER=console
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google OAuth (disabled unless enabled AND credentials are set)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# --- Database ---
POSTGRES_USER=researchforge
POSTGRES_PASSWORD=researchforge
POSTGRES_DB=researchforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://researchforge:researchforge@localhost:5432/researchforge
DATABASE_URL_SYNC=postgresql+psycopg://researchforge:researchforge@localhost:5432/researchforge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=researchforge
S3_REGION=us-east-1
S3_USE_SSL=false

# --- File upload limits ---
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/markdown,text/csv,text/x-bibtex,application/x-bibtex,application/x-research-info-systems,application/json,image/png,image/jpeg

# --- Export downloads ---
EXPORT_DOWNLOAD_EXPIRE_SECONDS=900
EXPORT_MAX_JOBS_PER_DAY=50

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# --- AI (OpenAI-compatible / vLLM) ---
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://localhost:8001/v1
AI_API_KEY=not-needed-for-local-vllm
AI_MODEL_NAME=researchforge-local
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=2048
# Use "fake" for deterministic tests
AI_PROVIDER_FOR_TESTS=fake

# --- Guest / product policy ---
GUEST_OUTLINE_MAX_SECTIONS=6
TRAINING_OPT_IN_DEFAULT=false
